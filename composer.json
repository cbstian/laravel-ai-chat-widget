{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cbstian/laravel-ai-chat-widget",
    "description": "Widget de chat IA flotante para Laravel y Livewire. UI, persistencia opcional y tools para leer Markdown; el agente de dominio se conecta con laravel/ai.",
    "keywords": [
        "laravel",
        "livewire",
        "ai",
        "chat",
        "widget",
        "filament",
        "markdown"
    ],
    "homepage": "https://github.com/cbstian/laravel-ai-chat-widget",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastian Aguilera",
            "homepage": "https://github.com/cbstian",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "livewire/livewire": "^4.0",
        "laravel/ai": "^0.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Cbstian\\AiChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbstian\\AiChat\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbstian\\AiChat\\AiChatServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filament/filament": "Para montar el widget con PanelsRenderHook::BODY_END"
    },
    "support": {
        "issues": "https://github.com/cbstian/laravel-ai-chat-widget/issues",
        "source": "https://github.com/cbstian/laravel-ai-chat-widget"
    }
}
